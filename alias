# only alias pi to omp when the real pi binary is not installed
if ! command -v pi >/dev/null 2>&1; then
    alias pi='omp'
fi

# only alias vim to nvim when nvim is installed
if command -v nvim >/dev/null 2>&1; then
    alias vim='nvim'
fi

# only alias z to the zed cli when zed is installed
if command -v zed >/dev/null 2>&1; then
    alias z='zed'
fi

alias npm-list='npm list --global --depth 0'

alias users='grep -v "^#" /etc/passwd | cut -d: -f1'

alias dns='sudo killall -HUP mDNSResponder'
alias reset-launchpad='defaults write com.apple.dock ResetLaunchPad -bool true; killall Dock'

# NO_COLOR is inherited from the GUI launch environment; clear it for tig only.
alias tig='NO_COLOR= tig'
