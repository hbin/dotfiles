#!/usr/bin/env bash
# Link this repo's config files into $HOME.
#
# Safe to re-run and safe to run on its own: files that would be overwritten
# are moved to ~/.dotfiles-backup first (only symlinks pointing into this repo
# are replaced in place).
#
# Usage: scripts/stow [--dry-run]

set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BACKUP="$HOME/.dotfiles-backup"
DRY_RUN=0
STAMP="$(date +%Y%m%d%H%M%S)"

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '\033[1;36m[dry-run]\033[0m %s\n' "$*"
  else
    "$@"
  fi
}

warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }

case "${1:-}" in
  -n|--dry-run) DRY_RUN=1 ;;
  -h|--help)    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "")           ;;
  *)            echo "unknown option: $1" >&2; exit 2 ;;
esac

[ -d "$DOTFILES" ] || { echo "dotfiles dir not found: $DOTFILES" >&2; exit 1; }

# Move a real file/dir aside so it is never silently destroyed. Symlinks are
# left alone (ln -sf replaces them) and missing paths need no backup.
backup() {
  local path="$1" name
  [ -e "$path" ] || return 0
  [ -L "$path" ] && return 0
  name="$(basename "$path")"; name="${name#.}"
  run mkdir -p "$BACKUP"
  run mv "$path" "$BACKUP/$name.$STAMP"
}

# ------------------------------------------------------------- shell & tool configs

FILES=(
  alias bashrc bash_profile ctags gitconfig gitignore_global globalrc
  ideavimrc profile pryrc vimrc vimrc.after vimrc.before
  zprofile zshenv zshrc
)

linked=0
for f in "${FILES[@]}"; do
  src="$DOTFILES/$f"
  if [ ! -f "$src" ]; then
    warn "not in repo, skipping: $f"
    continue
  fi
  backup "$HOME/.$f"
  run ln -sfn "$src" "$HOME/.$f"
  linked=$((linked + 1))
done

# ------------------------------------------------------------------ user bin dir
# Executables in bin/ are linked into ~/.local/bin, which both shells already
# prepend to PATH. That is what makes `git rollback` resolve to bin/git-rollback:
# git looks up an executable named git-<subcommand> on PATH.

if [ -d "$DOTFILES/bin" ]; then
  run mkdir -p "$HOME/.local/bin"
  for f in "$DOTFILES"/bin/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    backup "$HOME/.local/bin/$name"
    run ln -sfn "$f" "$HOME/.local/bin/$name"
    linked=$((linked + 1))
  done
fi

# ------------------------------------------------------------------- Emacs Doom

if [ -d "$DOTFILES/doom.d" ]; then
  if [ -L "$HOME/.doom.d" ] || [ ! -e "$HOME/.doom.d" ]; then
    run rm -rf "$HOME/.doom.d"
  else
    backup "$HOME/.doom.d"
  fi
  run ln -sfn "$DOTFILES/doom.d" "$HOME/.doom.d"
fi

# --------------------------------------------------------------------- Karabiner
# macOS only — Karabiner-Elements does not exist on Linux.

if [ "$(uname -s)" = "Darwin" ] && [ -f "$DOTFILES/karabiner.json" ]; then
  target="$HOME/.config/karabiner/karabiner.json"
  run mkdir -p "$HOME/.config/karabiner"
  # Karabiner writes this file from its GUI: keep the current one if it differs
  # from the repo copy (skip the copy when identical, so re-runs stay quiet).
  if [ -f "$target" ] && ! cmp -s "$target" "$DOTFILES/karabiner.json"; then
    backup "$target"
  fi
  run cp "$DOTFILES/karabiner.json" "$target"
fi

# ------------------------------------------------------------------------- done

printf 'Linked %d configs from %s\n' "$linked" "$DOTFILES"
[ -d "$BACKUP" ] && printf 'Previous files (if any) are in %s\n' "$BACKUP"
exit 0
