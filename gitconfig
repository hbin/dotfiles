# Identity is machine-local and untracked (this repo is public):
# ~/.gitconfig.local defines [user] name/email.
[include]
  path = ~/.gitconfig.local

[color]
  ui = true
  diff = auto
  status = auto
  branch = auto
  pager  = true
  interactive = auto

[core]
  pager  = less -FRSX
  whitespace = -indent-with-non-tab,trailing-space,cr-at-eol
  excludesfile = ~/.gitignore_global

[diff]
  tool = vimdiff

[difftool]
  prompt = false

[merge]
  tool = vimdiff

[init]
  defaultBranch = master

[grep]
  extendedRegexp = true
  lineNumber = true

[alias]
  g = grep --break --heading --line-number
